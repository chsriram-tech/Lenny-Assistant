# ============================================================
# THE LENNY GROWTH ASSISTANT - ENVIRONMENT CONFIGURATION
# ============================================================

# Database Configuration (PostgreSQL / Embedded Vector SQLite fallback)
DATABASE_URL=sqlite:///./lenny_growth_assistant.db
# For PostgreSQL in Docker or Railway:
# DATABASE_URL=postgresql://lenny:lenny_password@localhost:5432/lenny_growth_db

# Local Ollama Configuration (Mandatory demo target)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Cloud LLM Configuration (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Default Selected Provider ('ollama', 'anthropic', 'openai')
DEFAULT_PROVIDER=ollama
